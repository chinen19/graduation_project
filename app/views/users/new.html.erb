<div class="container">
  <div class="row">
    <div class="col-md-6 offset-md-3">
      <h1 class="text-center mb-4">ユーザー登録</h1>

      <%= form_with model: @user, local: true do |f| %>
      <!--  form_with入力フォームを作成するためのヘルパーメソッド。model: @user と指定するだけで、「新規作成ならこのURL（POST）」「編集ならこのURL（PATCH）」と、適切な送信先を自動で判断 -->
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <h4><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h4>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
            <!--  エラーがない時は何も表示せず、エラーがある時だけ警告文を表示する -->
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

  <!--   Bootstrap を使わず、独自のクラス名を使う（ -->
  <div class="user-form">
    <div class="form-field">
      <%= f.label :user_name, "ユーザー名", class: "form-label" %>
      <%= f.text_field :user_name, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :email, "メールアドレス", class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :password, "パスワード", class: "form-label" %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= f.submit "登録", class: "btn-primary" %>
    </div>
</div>
<% end %>
