<!DOCTYPE html>
<html>
  <head>
    <title>簡単整理メモアプリ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %> 
    <%= javascript_importmap_tags %>
    
  </head>

  <body>
    <!-- ログイン画面とユーザー登録画面では専用のヘッダーを表示 -->
    <% if controller_name == 'user_sessions' || (controller_name == 'users' && action_name == 'new') %>
      <%= render 'shared/auth_header' %>
    <% else %>
      <%= render 'shared/header' %>
    <% end %>
    
    <!-- フラッシュメッセージ -->
    <% flash.each do |message_type, message| %>
      <div class="container mx-auto px-4 mt-4">
        <div class="alert alert-<%= message_type %> bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded">
          <%= message %>
        </div>
      </div>
    <% end %>

    <%= yield %>

    <!-- フッター(全ページで表示) -->
    <%= render 'shared/footer' %>
  </body>
</html>
