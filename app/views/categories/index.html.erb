<h1>カテゴリ一覧</h1>

<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>名前</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.id %></td>
        <td><%= category.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to '戻る', root_path, class: 'btn btn-secondary' %>
