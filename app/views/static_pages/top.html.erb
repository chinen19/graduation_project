<div class="container">
  <h1>トップページ</h1>

  <% if logged_in? %>
    <p>ようこそ、<%= current_user.user_name %> さん!</p>
    <%= link_to "ログアウト", logout_path, data: { turbo_method: :delete }, class: "btn btn-danger" %>
  <% else %>
    <%= link_to "ログイン", login_path, class: "btn btn-primary" %>
    <%= link_to "新規登録", new_user_path, class: "btn btn-success" %>
  <% end %>
</div>
