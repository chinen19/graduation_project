<header class="bg-gray-50 shadow-sm border-b border-gray-200">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- 左側: アプリ名 -->
      <div class="flex items-center">
        <h1 class="text-2xl font-bold text-gray-800">
          簡単整理メモアプリ
        </h1>
      </div>

      <!-- 右側: ログイン/新規登録リンク -->
      <div class="flex items-center space-x-4">
        <% if controller_name == 'user_sessions' %>
          <span class="text-gray-600">アカウントをお持ちでない方</span>
          <%= link_to "新規登録", new_user_path, class: "bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition duration-200" %>
        <% elsif controller_name == 'users' && action_name == 'new' %>
          <span class="text-gray-600">すでにアカウントをお持ちの方</span>
          <%= link_to "ログイン", login_path, class: "bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition duration-200" %>
        <% end %>
      </div>
    </div>
  </nav>
</header>