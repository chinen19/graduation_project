<div class="min-h-screen bg-gray-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full bg-white rounded-lg shadow-md p-8">
    <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">ログイン</h1>

    <%= form_with url: login_path, local: true, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.password_field :password, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.submit "ログイン", class: "w-full bg-blue-500 text-white py-2 px-4 rounded-md hover:bg-blue-600 transition duration-200" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= link_to "新規登録", new_user_path, class: "text-blue-500 hover:text-blue-700" %>
    </div>
  </div>
</div>


