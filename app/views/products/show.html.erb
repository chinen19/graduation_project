<%= turbo_frame_tag "modal" do %>
  <div class="p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-2xl font-bold">メモ詳細</h2>
      <%= link_to "×", root_path, class: "text-gray-500 hover:text-gray-700 text-2xl", data: { turbo_frame: "_top" } %>
    </div>
    
    <div class="space-y-4">
      <div>
        <h3 class="text-lg font-semibold">商品名</h3>
        <p class="text-gray-700"><%= @product.name %></p>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold">カテゴリー</h3>
        <p class="text-gray-700"><%= @product.category.name %></p>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold">評価</h3>
        <p class="text-gray-700"><%= '★' * @product.rating.to_i %><%= '☆' * (5 - @product.rating.to_i) %></p>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold">メモ</h3>
        <p class="text-gray-700"><%= @product.comment %></p>
      </div>
    </div>
    
    <div class="mt-6 flex gap-4">
      <%= link_to '編集', edit_product_path(@product), 
          data: { turbo_frame: "modal" }, 
          class: 'bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded' %>
      <%= link_to '閉じる', root_path, 
          data: { turbo_frame: "_top" }, 
          class: 'bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded' %>
    </div>
  </div>
<% end %>