<div class="container mx-auto px-4 py-8">
  <!-- ヘッダー -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold mb-4">簡単整理メモアプリ</h1>
  </div>

  <!-- 並べ替えボタン -->
  <div class="mb-6">
    <div class="flex gap-3 flex-wrap">
      <%= link_to '評価高い順', products_path(sort: 'rating', category_id: params[:category_id]), 
          class: "px-6 py-2 rounded-lg transition #{params[:sort] == 'rating' ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
      <%= link_to 'カテゴリ順', products_path(sort: 'category', category_id: params[:category_id]), 
          class: "px-6 py-2 rounded-lg transition #{params[:sort] == 'category' ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
    </div>
  </div>

  <!-- カテゴリ絞り込み -->
  <div class="mb-6">
    <div class="flex gap-3 flex-wrap">
      <%= link_to 'すべて', products_path(sort: params[:sort]), 
          class: "px-4 py-2 rounded-lg transition #{params[:category_id].blank? ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
      <% @categories.each do |category| %>
        <%= link_to category.name, products_path(category_id: category.id, sort: params[:sort]), 
            class: "px-4 py-2 rounded-lg transition #{params[:category_id].to_i == category.id ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
      <% end %>
    </div>
  </div>

  <!-- メモ一覧（上に移動） -->
  <div class="mb-6">
    <h2 class="text-2xl font-bold mb-4">メモ一覧</h2>
  </div>

  <div id="products-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
    <% if @products.any? %>
      <% @products.each do |product| %>
        <div id="product-<%= product.id %>" class="bg-white p-4 rounded-lg shadow-md hover:shadow-lg transition">
          <h3 class="text-xl font-bold mb-2"><%= product.name %></h3>
          <p class="text-sm text-gray-600 mb-1">
            <span class="font-semibold">カテゴリー:</span> <%= product.category.name %>
          </p>
          <p class="text-sm text-gray-600 mb-1">
            <span class="font-semibold">評価:</span>
            <span class="text-yellow-500"><%= '★' * product.rating.to_i %></span>
            <span class="text-gray-300"><%= '☆' * (5 - product.rating.to_i) %></span>
          </p>
          <p class="text-sm text-gray-700 mb-3">
            <span class="font-semibold">メモ:</span> <%= product.comment %>
          </p>
          <div class="flex gap-2">
            <%= link_to '編集', edit_product_path(product), 
                data: { turbo_frame: "modal" },
                class: "px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 transition" %>
            <%= link_to '削除', product_path(product), 
                data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか?' },
                class: "px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600 transition" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="col-span-full text-center text-gray-500 py-8">メモが登録されていません</p>
    <% end %>
  </div>

  <!-- メモ作成フォーム（下に移動） -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <h2 class="text-2xl font-bold mb-4">メモ作成</h2>
    <%= render "form", product: @product %>
  </div>

  <!-- Turbo Frame Modal -->
  <%= turbo_frame_tag "modal" %>
</div>

